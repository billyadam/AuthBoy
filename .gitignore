# Build output (regenerated by `make`)
build/
*.elf
*.gba
*.map

# Host test binaries (regenerated by `make -C tests`)
tests/totp_host_test
tests/vault_host_test
tests/store_host_test
tests/*.o

# Save files and emulator states: these contain account secrets.
# Never commit them.
*.sav
*.srm
*.ss[0-9]
*.state
*.state[0-9]*
*.sgm

# Editor / OS clutter
.vscode/
*.swp
.DS_Store
